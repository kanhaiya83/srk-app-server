datasource mydatabase {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================
// ENUMS
// ============================

enum RoleType {
  seller
  buyer
  apmc_admin
}

enum MeasuringUnit {
  KGS
  QUINTLES
  TONNES
}

enum Commodity {
  JEERA
  DHANIYA
}

enum AuctionType {
  FORWARD
  BACKWARD
}

enum CompanyNature {
  Private
  LLC
  Partnership
  Proprietorship
}

enum VendorRole {
  Buyer
  Seller
  Both
}

enum BusinessType {
  Trading
  Retailer
  Miller
  Processor
  Importer
  Exporter
}

enum AuctionStatus {
  Pending
  Open
  Closed
}

// ============================
// CORE MODELS
// ============================

model User {
  id               String       @id @default(uuid())
  first_name       String
  last_name        String
  mobile_number    String
  roles            Role[]
  auctions_created Auction[]    @relation("UserAuctions")
  bids             Bid[]
  chatRooms        ChatRoom[]   @relation("ChatRoomMembers")
  messages         Message[]
  auctionParticipation Auction[] @relation("AuctionParticipants")
  auctionQualifiedIn Auction[]  @relation("AuctionQualifiers")
  auctionWon        Auction[]   @relation("AuctionWon")
}

model Role {
  id              String   @id @default(uuid())
  type            RoleType
  is_approved     Boolean
  assignment_date DateTime
  permissions     String[]
  apmc_id         String
  apmc            APMC     @relation(fields: [apmc_id], references: [id])
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])
}

model Location {
  id     String @id @default(uuid())
  title  String
  apmcs  APMC[]
}

model APMC {
  id          String  @id @default(uuid())
  location_id String
  location    Location @relation(fields: [location_id], references: [id])
  users       Role[]
  shops       Shop[]
}

model Shop {
  id      String @id @default(uuid())
  name    String
  apmc_id String
  apmc    APMC   @relation(fields: [apmc_id], references: [id])
}

// ============================
// AUCTION MODELS
// ============================

model Auction {
  id                           String       @id @default(uuid())
  title                        String
  description                  String?
  commodity                    Commodity
  grade                        String
  auction_type                 AuctionType
  is_private                   Boolean
  is_two_rounds                Boolean
  first_round_duration         Int
  current_round                Int
  first_round_bid_period       Int
  first_round_qualifiers_count Int?
  second_round_duration        Int?
  second_round_bid_period      Int?
  reminder_time_before_start   Int
  joining_start_time           DateTime
  start_time                   DateTime
  second_round_start_time      DateTime
  tick_size                    Float
  expected_price               Float
  initial_bid                  Float
  quantity                     Float
  measuring_unit               MeasuringUnit
  location                     String
  min_notional_entry           Float
  auction_status               AuctionStatus @default(Pending)

  // Relationships
  bids                         Bid[]
  creator                      User          @relation("UserAuctions", fields: [creatorId], references: [id])
  creatorId                    String
  participants                 User[]        @relation("AuctionParticipants")
  first_round_qualifiers       User[]        @relation("AuctionQualifiers")
  winner                       User[]        @relation("AuctionWon")
  chatRoom                     ChatRoom?
}

model Bid {
  id        Int      @id @default(autoincrement())
  auctionId String
  userId    String
  amount    Float
  timestamp DateTime @default(now())

  auction   Auction @relation(fields: [auctionId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id         Int      @id @default(autoincrement())
  auctionId  String   @unique
  auction    Auction  @relation(fields: [auctionId], references: [id])
  members    User[]   @relation("ChatRoomMembers")
  messages   Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  chatRoomId Int
  vendorId   String
  text       String
  timestamp  DateTime @default(now())

  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  vendor     User     @relation(fields: [vendorId], references: [id])
}